# Copy to .env (gitignored). Only DATABASE_URL is required.
DATABASE_URL=postgresql://user:password@host/db

# Email (optional). Without GMAIL_USER and GMAIL_APP_PASSWORD the app sends nothing and hides every email feature.
# The Gmail account that sends the mails (best a dedicated one), and its app password
# (Google account → Security → 2-Step Verification on → App passwords; 16 letters, spaces optional)
# GMAIL_USER=team.events@gmail.com
# GMAIL_APP_PASSWORD=
# Sender name shown on mails (default: Team Events)
# MAIL_FROM_NAME=Gather
# Public address of the site, used in links inside mails (no trailing slash)
# APP_URL=https://events.example.com
# Long random string (openssl rand -hex 32): signs links in mails and keys the one-time codes. Changing it invalidates both.
# NOTIFY_SECRET=
# Comma-separated domains allowed for member emails; empty allows any
# ALLOWED_EMAIL_DOMAINS=example.com

# Scheduled tick (optional). Netlify's hourly function sends this in x-cron-secret; without it POST /api/cron/tick answers 404.
# CRON_SECRET=
